{
  "expo": {
    "name": "NinjaCarMobile",
    "slug": "NinjaCarMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ninja_mask.png",
    "backgroundColor": "#B0DAA6",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/ninja_mask.png",
          "backgroundColor": "#F5F5F5",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B0DAA6",
        "foregroundImage": "./assets/ninja_mask.png",
        "backgroundImage": "./assets/ninja_mask.png",
        "monochromeImage": "./assets/ninja_mask.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/ninja_mask.png"
    }
  }
}
